# Configuration des webhooks n8n pour AutoExpert
# Copiez ce fichier vers .env.local et configurez vos URLs

# IMPORTANT: Remplacez 'votre-n8n-instance.com' par votre vraie URL n8n

# Webhook pour les réservations de rendez-vous
VITE_N8N_WEBHOOK_RESERVATION=https://votre-n8n-instance.com/webhook/reservation

# Webhook pour les modifications de rendez-vous
VITE_N8N_WEBHOOK_MODIFICATION=https://votre-n8n-instance.com/webhook/modification

# Webhook pour les annulations de rendez-vous  
VITE_N8N_WEBHOOK_ANNULATION=https://votre-n8n-instance.com/webhook/annulation

# Webhook pour les évaluations de satisfaction
VITE_N8N_WEBHOOK_SATISFACTION=https://votre-n8n-instance.com/webhook/satisfaction

# Webhook pour les rappels de maintenance
VITE_N8N_WEBHOOK_MAINTENANCE=https://votre-n8n-instance.com/webhook/maintenance

# Webhook pour les formulaires de contact
VITE_N8N_WEBHOOK_CONTACT=https://votre-n8n-instance.com/webhook/contact

# Instructions:
# 1. Copiez ce fichier vers .env.local
# 2. Remplacez les URLs par vos vrais webhooks n8n  
# 3. Assurez-vous que vos workflows n8n sont configurés pour recevoir ces webhooks
# 4. Testez chaque webhook avant de mettre en production